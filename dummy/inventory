all:
  children:
    network_devices:
      hosts:
        sw1:
          ansible_host: sw1
          ansible_network_os: ios
          dummy_device: tests/fixtures/l2/sw1.json
        sw2:
          ansible_host: sw2
          ansible_network_os: ios
          dummy_device: tests/fixtures/l2/sw2.json
        rtr1:
          ansible_host: rtr1
          ansible_network_os: ios
          dummy_device: tests/fixtures/l2/rtr1.json
        hq:
          ansible_host: hq
          ansible_network_os: iosxe
          dummy_device: tests/fixtures/facts/hq.json
        # Uncomment to check the configuration-change safeguard fails this host:
        # sw1-configchange:
        #   ansible_host: sw1
        #   ansible_network_os: ios
        #   dummy_device: tests/fixtures/l2/sw1.json
        #   dummy_mode: configchange
        # Uncomment to check a confirmation prompt is cancelled, not answered:
        # sw1-confirm:
        #   ansible_host: sw1
        #   ansible_network_os: ios
        #   dummy_device: tests/fixtures/l2/sw1.json
        #   dummy_mode: confirm

# Dummy devices (this file is YAML: dummy/inventory) for a test run of playbooks/collect_facts.yml that
# contacts no real device and uses no network. Each host has
# `dummy_device`: the playbook then runs it against dummy/bin/ssh, a
# simulated Cisco IOS device that replays the saved output in that file,
# instead of the real ssh client. Everything else (collect.py, the SSH
# session, the read-only policy, the audit and the JSON check) is the
# production code, unchanged.
#
# The hosts: sw1 and sw2 are Catalyst 9300 switches joined by a
# port-channel, with LLDP/CDP, MAC tables and VLANs; rtr1 is a router (no
# MAC table, so that command is skipped); hq is an IOS-XE router with IPsec
# tunnels.
#
# Use any credential: the dummy devices accept any non-empty password.
#
# Optional, to see the safeguards stop a run (each of these hosts must
# fail): set dummy_mode on a host to
#   configchange  the configuration changes during collection (exit 3)
#   confirm       the device asks "[confirm]", which must be cancelled
#
# The file has no extension so that AWX offers it as an inventory file:
# AWX's file picker lists files named "inventory" or "hosts", .ini files,
# executable files and files with no extension, but not .yml. Ansible reads
# it as YAML either way. These comments are at the end because AWX checks
# the first lines of a file with no extension for unusual characters.
